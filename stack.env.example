# Copy to stack.env and adjust as needed.
# Timezone is provided by /etc/localtime and /etc/timezone mounts.
# TZ=America/New_York

HIP_VISIBLE_DEVICES=0
HF_HUB_ENABLE_HF_TRANSFER=1
HF_XET_HIGH_PERFORMANCE=1
COMFYUI_PORT=8188
TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL=0
TORCH_BLAS_PREFER_HIPBLASLT=1
IVBOX_ENABLE_AOTRITON=0

# Empty uses the image defaults:
# --bf16-vae --disable-mmap
COMFYUI_FLAGS=

# Additional ComfyUI arguments, for example --reserve-vram 2
COMFYUI_ARGS=
